# ── THE SYSTEM · environment ─────────────────────────────────
# Copy to .env.local and fill in. Never commit real keys.

# OpenRouter (LLM + speech) — https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=
# chat model for both Systems
MODEL_ID=openai/gpt-oss-120b

# optional — Vercel Edge Config; its MODEL_ID item overrides the env var without a redeploy
# EDGE_CONFIG=
# optional — sent to OpenRouter as HTTP-Referer
# SITE_URL=https://your-domain.dev

# voice pipeline (OpenRouter audio)
STT_MODEL_ID=openai/gpt-4o-mini-transcribe
TTS_MODEL_ID=mistralai/voxtral-mini-tts-2603
# optional — a voice of the TTS model
# TTS_VOICE=gb_oliver_confident

# tracing (LangSmith) — https://smith.langchain.com/settings
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=portfolio
